<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.MainActivity"
        android:background="@color/new_bg">

        <LinearLayout
            android:id="@+id/layout_mypage_profile_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="31dp"
            android:paddingVertical="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_mypage_profile_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_mypage_back"/>

            <TextView
                android:id="@+id/tv_mypage_profile_topbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY Profile"
                style="@style/TextAppearance.LCK.Medium.16sp"
                android:textColor="@color/white"
                android:layout_weight="1"
                android:gravity="center"/>

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_mypage_profile_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/layout_mypage_profile_topbar"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="24dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/iv_mypage_main_rect"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/iv_mypage_profile_profile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/img_signup_profile"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/tv_mypage_main_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="닉네임"
                        style="@style/TextAppearance.LCK.Light.20sp"
                        android:textColor="@color/text_white"/>

                    <TextView
                        android:id="@+id/tv_mypage_main_team"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kt"
                        style="@style/TextAppearance.LCK.Medium.10sp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/shape_rect_4_gray_fill"
                        android:padding="4dp"
                        android:layout_gravity="center"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_mypage_main_my_tier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tier"
                    style="@style/TextAppearance.LCK.Light.14sp"
                    android:textColor="@color/grayscale_300"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="45dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_mypage_profile_beta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beta"
                    style="@style/TextAppearance.LCK.Light.8sp"
                    android:textColor="@color/new_bg"
                    android:background="@drawable/shape_rect_4_beta"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"/>

                <View
                    android:id="@+id/view_mypage_profile_tier_line"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@drawable/shape_rect_mypage_profile_tier"
                    android:layout_marginTop="38dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="1">
                        <TextView
                            android:id="@+id/tv_mypage_profile_bronze_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bronze"
                            style="@style/TextAppearance.LCK.Medium.10sp"
                            android:textColor="@color/grayscale_500"/>
                        <View
                            android:id="@+id/view_mypage_profile_circle_bronze"
                            android:layout_width="4dp"
                            android:layout_height="5dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/shape_oval_none"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="1">
                        <TextView
                            android:id="@+id/tv_mypage_profile_silver_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Silver"
                            style="@style/TextAppearance.LCK.Medium.10sp"
                            android:textColor="@color/grayscale_500"/>
                        <View
                            android:id="@+id/view_mypage_profile_circle_silver"
                            android:layout_width="4dp"
                            android:layout_height="5dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/shape_oval_none"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="1">
                        <TextView
                            android:id="@+id/tv_mypage_profile_gold_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gold"
                            style="@style/TextAppearance.LCK.Medium.10sp"
                            android:textColor="@color/grayscale_500"/>
                        <View
                            android:id="@+id/view_mypage_profile_circle_gold"
                            android:layout_width="4dp"
                            android:layout_height="5dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/shape_oval_none"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="1">
                        <TextView
                            android:id="@+id/tv_mypage_profile_master_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Master"
                            style="@style/TextAppearance.LCK.Medium.10sp"
                            android:textColor="@color/grayscale_500"/>
                        <View
                            android:id="@+id/view_mypage_profile_circle_master"
                            android:layout_width="4dp"
                            android:layout_height="5dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/shape_oval_none"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="1">
                        <TextView
                            android:id="@+id/tv_mypage_profile_challenger_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Challenger"
                            style="@style/TextAppearance.LCK.Medium.10sp"
                            android:textColor="@color/grayscale_500"/>
                        <View
                            android:id="@+id/view_mypage_profile_circle_challenger"
                            android:layout_width="4dp"
                            android:layout_height="5dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/shape_oval_none"/>
                    </LinearLayout>


                </LinearLayout>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/grayscale_900"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginHorizontal="30dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/layout_mypage_profile_profile"
            android:layout_marginTop="36dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_mypage_profile_edit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="프로필 수정"
                style="@style/TextAppearance.LCK.Light.14sp"
                android:textColor="@color/grayscale_100"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white_20"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_mypage_profile_logout_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="로그아웃"
                style="@style/TextAppearance.LCK.Light.14sp"
                android:textColor="@color/grayscale_100"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white_20"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_mypage_profile_withdraw_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="계정탈퇴"
                style="@style/TextAppearance.LCK.Light.14sp"
                android:textColor="@color/grayscale_100"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>