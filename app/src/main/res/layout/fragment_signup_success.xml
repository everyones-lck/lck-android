<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/new_bg">


        <!--선택 팀에 따라 뒤에 이미지 변경-->
        <ImageView
            android:id="@+id/iv_signup_success_background_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@drawable/img_white"/>

        <ImageView
            android:id="@+id/iv_signup_success_back"
            android:layout_width="9dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_back_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/layout_signup_success_topbar"
            app:layout_constraintBottom_toBottomOf="@id/layout_signup_success_topbar"
            android:layout_marginStart="30dp"
            android:onClick="onNextButtonClick"/>
        <LinearLayout
            android:id="@+id/layout_signup_success_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="4dp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="76dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_signup_success_topbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원가입"
                style="@style/TextAppearance.LCK.Medium.16sp"
                android:textColor="@color/white"
                android:gravity="center_horizontal"/>

            <TextView
                android:id="@+id/tv_signup_success_topbar_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원가입 완료"
                style="@style/TextAppearance.LCK.Light.12sp"
                android:textColor="@color/white"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="64dp"
            android:layout_marginTop="84dp"
            app:layout_constraintTop_toBottomOf="@id/layout_signup_success_topbar"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_signup_success_congratulation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="___님 가입을 축하드립니다 !"
                style="@style/TextAppearance.LCK.Medium.12sp"
                android:gravity="center"
                android:textColor="@color/white"/>
            <ImageView
                android:id="@+id/iv_signup_success_profile"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/img_signup_profile"
                android:layout_marginTop="24dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_rect_4_gray_line_black_fill"
                android:scaleType="centerCrop"/>
        </LinearLayout>


        <TextView
            android:id="@+id/tv_signup_success_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_rect_4_gray_line_black_fill"
            android:text="넘어가기"
            style="@style/TextAppearance.LCK.Medium.12sp"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="58dp"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
