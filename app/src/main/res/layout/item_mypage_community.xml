<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="post"
            type="umc.everyones.lck.domain.model.community.Post" />
        <variable
            name="comment"
            type="umc.everyones.lck.domain.model.community.Comment" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/shape_rect_12_grayscale_200">

        <LinearLayout
            android:id="@+id/layout_mypage_community"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_mypage_community_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/Esamanru.Light.body01"
                android:textColor="@color/grayscale_800"
                tools:text="Sample Title"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:src="@drawable/img_community_logo"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_mypage_community_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textAppearance="@style/Esamanru.Light.label03"
            app:layout_constraintStart_toStartOf="@id/layout_mypage_community"
            app:layout_constraintTop_toBottomOf="@id/layout_mypage_community"
            android:layout_marginTop="20dp"
            android:textColor="@color/black"
            android:background="@drawable/shape_rect_4_grayscale_800_line"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            tools:text="#Category"/>

        <TextView
            android:id="@+id/tv_mypage_community_shortcuts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="바로가기 >"
            android:textAppearance="@style/Esamanru.Light.label03"
            app:layout_constraintStart_toEndOf="@id/tv_mypage_community_category"
            app:layout_constraintTop_toTopOf="@id/tv_mypage_community_category"
            android:layout_marginStart="8dp"
            android:textColor="@color/black"
            android:background="@drawable/shape_rect_4_grayscale_800_line"
            android:paddingVertical="2dp"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="16dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
