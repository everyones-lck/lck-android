<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000CC"
        android:padding="16dp">

        <!-- 중앙에 위치할 사각형 레이아웃 -->
        <RelativeLayout
            android:layout_width="280dp"
            android:layout_height="167dp"
            android:layout_centerInParent="true"
            android:background="@drawable/shape_rect_4_popover">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_dialog_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="회원가입"
                    style="@style/TextAppearance.LCK.Medium.12sp"
                    android:textColor="@color/bg_color"
                    android:layout_centerHorizontal="true"/>

                <TextView
                    android:id="@+id/tv_dialog_text"
                    style="@style/TextAppearance.LCK.Light.10sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:text="프로필 사진이 기본 이미지로 설정됩니다."
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:layout_marginTop="21dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="25dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="변경"
                        style="@style/TextAppearance.LCK.Medium.12sp"
                        android:background="@drawable/shape_rect_4_grayscale_300"
                        android:gravity="center"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="0dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="완료"
                        style="@style/TextAppearance.LCK.Medium.12sp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/shape_rect_4_newbg"/>
                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>
    </RelativeLayout>
</layout>
