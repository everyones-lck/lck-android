<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/new_bg">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_today_match_lck_match_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/item_lck_match_content"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:overScrollMode="never"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"/>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_today_match_lck_match_no_match"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <TextView
                android:id="@+id/tv_today_match_lck_no_match_team1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LCK.Medium"
                android:text="-"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toStartOf="@id/layout_today_no_match_vote_bar"
                app:layout_constraintTop_toBottomOf="@+id/layout_today_no_match_vote_bar"/>

            <TextView
                android:id="@+id/tv_today_match_lck_no_match_team2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LCK.Medium"
                android:text="-"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_marginTop="15dp"
                app:layout_constraintEnd_toEndOf="@id/layout_today_no_match_vote_bar"
                app:layout_constraintTop_toBottomOf="@+id/layout_today_no_match_vote_bar"/>

            <TextView
                android:id="@+id/tv_today_match_lck_no_match1_content"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                style="@style/TextAppearance.LCK.Medium"
                android:text="No Matches"
                android:textColor="@color/gray_200"
                android:textSize="18sp"
                android:layout_marginTop="5dp"
                app:layout_constraintTop_toBottomOf="@id/tv_today_match_lck_no_match1_date"
                app:layout_constraintStart_toStartOf="@id/tv_today_match_lck_no_match1_date" />

            <TextView
                android:id="@+id/tv_today_match_lck_no_match1_date"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                style="@style/TextAppearance.LCK.Light"
                android:text="00.00 00:00"
                android:textColor="@color/gray_800"
                android:textSize="10sp"
                android:layout_marginTop="25dp"
                android:layout_marginStart="30dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/layout_today_no_match_button_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="60dp"
                app:layout_constraintTop_toBottomOf="@+id/layout_today_no_match_vote_bar"
                app:layout_constraintStart_toStartOf="@+id/layout_today_no_match_vote_bar"
                >

                <TextView
                    android:id="@+id/tv_today_no_match1_prediction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Light"
                    android:text="승부 예측하기"
                    android:textColor="@color/gray_800"
                    android:textSize="10sp"
                    android:paddingVertical="11dp"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/shape_rect_4_gray_900_fill"
                    app:layout_constraintEnd_toStartOf="@+id/tv_today_no_match1_pog"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_today_no_match_vote_bar"/>

                <TextView
                    android:id="@+id/tv_today_no_match1_pog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Light"
                    android:text="Today's POG"
                    android:textColor="@color/gray_800"
                    android:textSize="10sp"
                    android:layout_marginStart="10dp"
                    android:paddingVertical="11dp"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/shape_rect_4_gray_900_fill" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_today_no_match_vote_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginHorizontal="30dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_today_match_lck_no_match1_content">

                <TextView
                    android:id="@+id/tv_today_no_match_team1_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/shape_rect_12_white_fill"
                    android:backgroundTint="@color/gray_200"
                    android:paddingVertical="2dp"
                    android:textSize="2dp"
                    />

                <TextView
                    android:id="@+id/tv_today_no_match_team2_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:background="@drawable/shape_rect_12_white_fill"
                    android:backgroundTint="@color/gray_500"
                    android:paddingVertical="2dp"
                    android:textSize="2dp"
                    android:layout_marginStart="2dp"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>