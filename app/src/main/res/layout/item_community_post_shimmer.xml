<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        tools:background="@color/new_bg">

        <TextView
            android:id="@+id/tv_post_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/shape_rect_4_gray_shimmer"
            android:text="1경기 전력 어떻게 봐?"
            android:textAppearance="@style/Esamanru.Light.body03"
            android:textColor="@color/gray_shimmer"
            app:layout_constraintStart_toStartOf="@id/cv_profile_image"
            app:layout_constraintTop_toBottomOf="@id/cv_profile_image" />

        <TextView
            android:id="@+id/tv_post_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/shape_rect_4_gray_shimmer"
            android:text="1경기 전력 어떻게 분석하면 좋을까요? 궁금합니다."
            android:textAppearance="@style/Esamanru.Light.label02"
            android:textColor="@color/gray_shimmer"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@id/cv_post_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/tv_post_title"
            app:layout_constraintTop_toBottomOf="@id/tv_post_title" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_profile_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/gray_shimmer"
            app:cardCornerRadius="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_profile_image"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_post_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/shape_rect_4_gray_shimmer"
            android:textAppearance="@style/Esamanru.Light.label03"
            android:textColor="@color/gray_shimmer"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_post_nickname"
            app:layout_constraintStart_toEndOf="@id/tv_post_favorite_team"
            tools:text="2024.03.08" />

        <TextView
            android:id="@+id/tv_post_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/shape_rect_4_gray_shimmer"
            android:text="Perfect 조아"
            android:textAppearance="@style/Esamanru.Light.label03"
            android:textColor="@color/gray_shimmer"
            app:layout_constraintBottom_toBottomOf="@id/cv_profile_image"
            app:layout_constraintStart_toEndOf="@id/cv_profile_image"
            app:layout_constraintTop_toTopOf="@id/cv_profile_image" />

        <TextView
            android:id="@+id/tv_post_favorite_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/shape_rect_4_gray_shimmer"
            android:text="T1"
            android:textAppearance="@style/Esamanru.Light.label03"
            android:textColor="@color/gray_shimmer"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_post_nickname"
            app:layout_constraintStart_toEndOf="@id/tv_post_nickname" />

        <ImageView
            android:id="@+id/iv_post_comment"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_rect_4_gray_shimmer"
            app:layout_constraintStart_toStartOf="@id/tv_post_title"
            app:layout_constraintTop_toBottomOf="@id/tv_post_body" />

        <TextView
            android:id="@+id/tv_post_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/shape_rect_4_gray_shimmer"
            android:textAppearance="@style/Esamanru.Light.label02"
            android:textColor="@color/gray_shimmer"
            app:layout_constraintBottom_toBottomOf="@id/iv_post_comment"
            app:layout_constraintStart_toEndOf="@id/iv_post_comment"
            app:layout_constraintTop_toTopOf="@id/iv_post_comment"
            tools:text="38" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_post_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="24dp"
            app:cardBackgroundColor="@color/gray_shimmer"
            app:cardCornerRadius="4dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_post_body"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cv_profile_image">

            <ImageView
                android:id="@+id/iv_post_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>