<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/new_bg"
        tools:context=".presentation.MainActivity">

        <LinearLayout
            android:id="@+id/layout_mypage_information_tos_agree_1_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="31dp"
            android:paddingVertical="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_mypage_information_tos_agree_1_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:src="@drawable/ic_back_btn"/>

            <TextView
                android:id="@+id/tv_mypage_information_tos_agree_1_topbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Information"
                android:textAppearance="@style/Esamanru.Medium.heading01"
                android:textColor="@color/grayscale_200"
                android:layout_weight="1"
                android:gravity="center"/>

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_mypage_information_tos_agree_1_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="30dp"
            android:text="개인정보 처리방침"
            android:textAppearance="@style/Esamanru.Medium.heading01"
            android:textColor="@color/grayscale_200"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_mypage_information_tos_agree_1_topbar" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:overScrollMode="never"
                android:layout_margin="30dp"
                app:layout_constraintTop_toBottomOf="@id/tv_mypage_information_tos_agree_1_title"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tv_mypage_information_tos_agree_1_detail"
                    android:textAppearance="@style/Esamanru.Light.label02"
                    android:textColor="@color/grayscale_200"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:text="@string/tos_details_agree_1" />
            </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
