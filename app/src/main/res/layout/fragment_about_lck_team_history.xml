<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/new_bg">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_about_lck_team_history_pre"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="16.25dp"
                    android:layout_marginTop="26dp"
                    android:src="@drawable/ic_arrow_thin_previous"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_about_lck_team_history_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T1"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/esamanru_light"
                    app:layout_constraintTop_toTopOf="@id/iv_about_lck_team_history_pre"
                    app:layout_constraintBottom_toBottomOf="@id/iv_about_lck_team_history_pre"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageView
                    android:id="@+id/iv_about_lck_team_history_uniform"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:src="@drawable/img_aboutlck_uniform_t1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_about_lck_team_history_pre" />

                <TextView
                    android:id="@+id/tv_about_lck_team_winning_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Winning History"
                    android:fontFamily="@font/esamanru_light"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="40dp"
                    app:layout_constraintTop_toBottomOf="@id/iv_about_lck_team_history_uniform"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="30dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_about_lck_team_winning_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="9dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_about_lck_team_winning_history"
                    android:overScrollMode="never"/>

                <View
                    android:id="@+id/view_about_lck_team_winning_history_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#656565"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rv_about_lck_team_winning_history"/>

                <ImageView
                    android:id="@+id/iv_about_lck_team_winning_history_down"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_aboutlck_arrow_down"
                    android:layout_marginEnd="30dp"
                    app:layout_constraintTop_toTopOf="@id/tv_about_lck_team_winning_history"
                    app:layout_constraintBottom_toBottomOf="@id/tv_about_lck_team_winning_history"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tv_about_lck_team_recent_performance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Performance"
                    android:fontFamily="@font/esamanru_light"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="27dp"
                    app:layout_constraintTop_toBottomOf="@id/view_about_lck_team_winning_history_line"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="30dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_about_lck_team_recent_performance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="9dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_about_lck_team_recent_performance"
                    android:overScrollMode="never"/>

                <View
                    android:id="@+id/view_about_lck_team_recent_performance_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#656565"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rv_about_lck_team_recent_performance"/>

                <ImageView
                    android:id="@+id/iv_about_lck_team_recent_performance_down"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_aboutlck_arrow_down"
                    android:layout_marginEnd="30dp"
                    app:layout_constraintTop_toTopOf="@id/tv_about_lck_team_recent_performance"
                    app:layout_constraintBottom_toBottomOf="@id/tv_about_lck_team_recent_performance"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tv_about_lck_team_history_of_roster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History Of Roaster"
                    android:fontFamily="@font/esamanru_light"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="27dp"
                    app:layout_constraintTop_toBottomOf="@id/view_about_lck_team_recent_performance_line"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="30dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_about_lck_team_history_of_roster"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="9dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_about_lck_team_history_of_roster"
                    android:overScrollMode="never"/>

                <ImageView
                    android:id="@+id/iv_about_lck_team_history_of_roster_down"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_aboutlck_arrow_down"
                    android:layout_marginEnd="30dp"
                    app:layout_constraintTop_toTopOf="@id/tv_about_lck_team_history_of_roster"
                    app:layout_constraintBottom_toBottomOf="@id/tv_about_lck_team_history_of_roster"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <View
                    android:id="@+id/view_about_lck_team_transparent"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="50dp"
                    android:background="#00FFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/rv_about_lck_team_history_of_roster" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>