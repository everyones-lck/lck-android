<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.MainActivity"
        android:background="@color/new_bg">

        <LinearLayout
            android:id="@+id/layout_mypage_main_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="31dp"
            android:paddingVertical="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_mypage_myteam_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_mypage_back"/>

            <TextView
                android:id="@+id/tv_mypage_myteam_topbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY Team 선택"
                style="@style/TextAppearance.LCK.Medium.16sp"
                android:textColor="@color/white"
                android:layout_weight="1"
                android:gravity="center"/>

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"/>

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_mypage_myteam_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/layout_mypage_main_topbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_mypage_myteam_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My team은 한달에 한 번 변경 가능합니다"
                style="@style/TextAppearance.LCK.Light.12sp"
                android:layout_marginTop="32dp"
                android:textColor="@color/warning"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TableLayout
                android:id="@+id/layout_mypage_myteam_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_mypage_myteam_warning"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TableRow>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_hanwha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_team_background"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginVertical="9dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_hanhwa"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/hanhwa"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="Hanwha"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_gen_g"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_team_background"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginHorizontal="8dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_gen_g"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/gen_g"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="Gen.G"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_t1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_team_background"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_t1"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/t1"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="T1"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>
                </TableRow>

                <TableRow>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_dn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_team_background"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginVertical="9dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_kwangdong_freecs"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/dn"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="DN"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_bnk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_team_background"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginHorizontal="8dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_bnk"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/bnk"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="BNK"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_red"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_team_background"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_nongshim_red_force"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="RED"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>
                </TableRow>

                <TableRow>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_drx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_team_background"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginVertical="9dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_drx"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/drx"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="DRX"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_brion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_team_background"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginHorizontal="8dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_ok_saving_bank_brion"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/brion"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="Brion"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_dk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_team_background"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_dplus_kia"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/white"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="DK"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>
                </TableRow>

                <TableRow>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_kt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_team_background"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginVertical="9dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_kt_rolster"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/t1"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="Kt"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>
                </TableRow>

            </TableLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_mypage_myteam_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_rect_4_gray_line_black_fill"
            android:text="변경"
            style="@style/TextAppearance.LCK.Medium.12sp"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="58dp"
            app:layout_constraintBottom_toBottomOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>