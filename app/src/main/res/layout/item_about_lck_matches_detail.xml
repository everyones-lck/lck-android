<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="11dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/shape_rect_8_gray_line"
        android:paddingHorizontal="15dp"
        android:paddingVertical="20dp">


        <TextView
            android:id="@+id/tv_match_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/esamanru_light"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:text="17:00"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_match_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/esamanru_medium"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:text="1st match"
            android:layout_marginTop="7dp"
            app:layout_constraintTop_toBottomOf="@id/tv_match_time"
            app:layout_constraintStart_toStartOf="@id/tv_match_time"/>

        <TextView
            android:id="@+id/tv_match_team1_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/esamanru_light"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:text="t1"
            android:layout_marginTop="13dp"
            app:layout_constraintTop_toBottomOf="@id/tv_match_title"
            app:layout_constraintStart_toStartOf="@id/tv_match_time"/>

        <TextView
            android:id="@+id/tv_match_vs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/esamanru_light"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:text=" vs "
            android:layout_marginTop="13dp"
            app:layout_constraintTop_toBottomOf="@id/tv_match_title"
            app:layout_constraintStart_toEndOf="@id/tv_match_team1_name" />

        <TextView
            android:id="@+id/tv_match_team2_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/esamanru_light"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:text="gen.g"
            android:layout_marginTop="13dp"
            app:layout_constraintTop_toBottomOf="@id/tv_match_title"
            app:layout_constraintStart_toEndOf="@id/tv_match_vs"/>

        <ImageView
            android:id="@+id/iv_match_team1"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/ic_aboutlck_team_color"
            app:layout_constraintEnd_toStartOf="@id/iv_match_team2"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageView
            android:id="@+id/iv_match_team2"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:background="@drawable/ic_aboutlck_team_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>