<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.MainActivity"
        android:background="@color/new_bg">

        <LinearLayout
            android:id="@+id/layout_mypage_viewing_party_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="31dp"
            android:paddingVertical="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_mypage_viewing_party_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:src="@drawable/ic_back_btn"/>

            <TextView
                android:id="@+id/tv_mypage_viewing_party_topbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY Viewing Party"
                android:textAppearance="@style/Esamanru.Medium.heading01"
                android:textColor="@color/grayscale_200"
                android:layout_weight="1"
                android:gravity="center"/>

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_mypage_viewing_party"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO Content"
            style="@style/TextAppearance.LCK.Light.20sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"/>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_mypage_viewing_party_guest_host"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="43dp"
            android:layout_height="wrap_content"
            android:background="@color/Transparency"
            app:layout_constraintTop_toBottomOf="@id/layout_mypage_viewing_party_topbar"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:tabIndicator="@null"
            app:tabRippleColor="@null"
            app:tabMode="fixed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tabSelectedTextAppearance="@style/Esamanru.Light.body03"
            app:tabTextAppearance="@style/Esamanru.Light.body03"
            app:tabSelectedTextColor="@color/grayscale_100"
            app:tabTextColor="@color/grayscale_800">

            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guest" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Host" />

        </com.google.android.material.tabs.TabLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/tab_mypage_viewing_party_guest_host"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>