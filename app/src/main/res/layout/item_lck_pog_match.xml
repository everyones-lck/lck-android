<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_item_today_match_lck_pog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingVertical="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/new_bg">

        <TextView
            android:id="@+id/tv_today_match_lck_pog_match_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.LCK.Medium"
            android:text="LCK Summer 1st Match"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@+id/tv_today_match_lck_pog_match_date"
            app:layout_constraintTop_toBottomOf="@+id/tv_today_match_lck_pog_match_date"/>

        <TextView
            android:id="@+id/tv_today_match_lck_pog_match_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.LCK.Light"
            android:text="0000.00.00. 00:00"
            android:textColor="@color/gray_800"
            android:textSize="10sp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="@id/layout_today_match_lck_pog_list"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_today_match_lck_pog_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_rect_4_gray_600_line"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_today_match_lck_pog_match_title">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_today_match_lck_pog_1st"
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_1st"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Medium"
                    android:text="1st POG"
                    android:gravity="center"
                    android:textColor="@color/gray_100"
                    android:textSize="14sp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_1st_player"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Light"
                    android:text=" - "
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_today_match_lck_pog_1st"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_today_match_lck_pog_2nd"
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:layout_constraintStart_toEndOf="@+id/layout_today_match_lck_pog_1st"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_2nd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Medium"
                    android:text="2nd POG"
                    android:gravity="center"
                    android:textColor="@color/gray_100"
                    android:textSize="14sp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_2nd_player"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Light"
                    android:text=" - "
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_today_match_lck_pog_2nd"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_today_match_lck_pog_3rd"
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:layout_constraintStart_toEndOf="@+id/layout_today_match_lck_pog_2nd"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_3rd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Medium"
                    android:text="3rd POG"
                    android:gravity="center"
                    android:textColor="@color/gray_100"
                    android:textSize="14sp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_3rd_player"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Light"
                    android:text=" - "
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_today_match_lck_pog_3rd"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_today_match_lck_pog_match"
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:layout_constraintStart_toEndOf="@+id/layout_today_match_lck_pog_3rd"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_match"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Medium"
                    android:text="by Match"
                    android:gravity="center"
                    android:textColor="@color/gray_100"
                    android:textSize="14sp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_match_player"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Light"
                    android:text=" - "
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_today_match_lck_pog_match"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_today_match_lck_pog_4th"
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:layout_constraintStart_toStartOf="@+id/layout_today_match_lck_pog_1st"
                app:layout_constraintTop_toBottomOf="@+id/layout_today_match_lck_pog_1st"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_4th"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Medium"
                    android:text="4th POG"
                    android:gravity="center"
                    android:textColor="@color/gray_100"
                    android:textSize="14sp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_4th_player"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Light"
                    android:text=" - "
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_today_match_lck_pog_4th"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_today_match_lck_5th_match"
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:layout_constraintStart_toEndOf="@+id/layout_today_match_lck_pog_4th"
                app:layout_constraintTop_toBottomOf="@+id/layout_today_match_lck_pog_1st"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_5th"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Medium"
                    android:text="5th POG"
                    android:gravity="center"
                    android:textColor="@color/gray_100"
                    android:textSize="14sp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_today_match_lck_pog_5th_player"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LCK.Light"
                    android:text=" - "
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_today_match_lck_pog_5th"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

<!--        <androidx.recyclerview.widget.RecyclerView-->
<!--            android:id="@+id/rv_today_match_lck_pog_player"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="30dp"-->
<!--            tools:listitem="@layout/item_lck_pog_player"-->
<!--            android:orientation="horizontal"-->
<!--            android:overScrollMode="never"-->
<!--            app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"-->
<!--            tools:itemCount="5"-->
<!--            app:layout_constraintStart_toStartOf="parent"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            app:layout_constraintTop_toBottomOf="@id/tv_today_match_lck_pog_match_title"/>-->
        
        <TextView
            android:id="@+id/tv_today_match_lck_pog_playing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            style="@style/TextAppearance.LCK.Light"
            android:text="During the game"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_today_match_lck_pog_match_title"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="1dp"
            android:background="#BBBBBB"
            android:alpha="0.4"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_today_match_lck_pog_list"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>