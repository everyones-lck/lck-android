<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <ImageView
        android:id="@+id/iv_today_match_prediction_team1_box"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:src="@drawable/shape_rect_4_gray_700_fill"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_today_match_prediction_team1_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.LCK.Light"
        android:text="TEAM 1"
        android:textSize="20sp"
        android:textColor="@color/gray_100"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/iv_today_match_prediction_team1_box"
        app:layout_constraintTop_toTopOf="@id/iv_today_match_prediction_team1_box"
        app:layout_constraintBottom_toBottomOf="@id/iv_today_match_prediction_team1_box"/>

    <ImageView
        android:id="@+id/iv_today_match_prediction_team2_box"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:src="@drawable/shape_rect_4_gray_700_fill"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_today_match_prediction_team1_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_today_match_prediction_team2_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.LCK.Light"
        android:text="TEAM 2"
        android:textSize="20sp"
        android:textColor="@color/gray_100"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/iv_today_match_prediction_team2_box"
        app:layout_constraintTop_toTopOf="@id/iv_today_match_prediction_team2_box"
        app:layout_constraintBottom_toBottomOf="@id/iv_today_match_prediction_team2_box"/>

</androidx.constraintlayout.widget.ConstraintLayout>