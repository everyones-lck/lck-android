<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_rect_12_white_fill"
        android:backgroundTint="@color/gray_200"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_viewing_party_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="18dp"
            android:textAppearance="@style/Esamanru.Light.body01"
            android:textColor="@color/gray_800"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="240514 홍대 뷰파" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_viewing_party_profile_bg"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="@id/tv_viewing_party_title"
            app:layout_constraintTop_toBottomOf="@id/tv_viewing_party_title">

            <ImageView
                android:id="@+id/iv_viewing_party_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_t1" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_viewing_party_writer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textAppearance="@style/Esamanru.Light.label03"
            android:textColor="@color/gray_600"
            app:layout_constraintBottom_toBottomOf="@id/cv_viewing_party_profile_bg"
            app:layout_constraintStart_toEndOf="@id/cv_viewing_party_profile_bg"
            app:layout_constraintTop_toTopOf="@id/cv_viewing_party_profile_bg"
            tools:text="Perfect 조아 | KT" />

        <ImageView
            android:id="@+id/iv_viewing_party_logo"
            android:layout_width="32dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/img_viewing_party_deco"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_viewing_party_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="15dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/shape_rect_4_gray_800_line"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:textAppearance="@style/Esamanru.Light.label03"
            android:textColor="@color/gray_800"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_viewing_party_date"
            app:layout_constraintTop_toBottomOf="@id/tv_viewing_party_writer"
            tools:text="부천시 역곡동" />

        <TextView
            android:id="@+id/tv_viewing_party_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/shape_rect_4_gray_800_line"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:textAppearance="@style/Esamanru.Light.label03"
            android:textColor="@color/gray_800"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_viewing_party_address"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="2024.07.10" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>