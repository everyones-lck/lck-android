                        android:gravity="center"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_signup_myteam_brion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/shape_team_background"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginHorizontal="8dp">

                    <View
                        android:id="@+id/iv_signup_myteam_ok_saving_bank_brion"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/shape_oval_red"
                        android:backgroundTint="@color/brion"
                        android:layout_gravity="center"/>

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="Brion"
                        android:layout_marginTop="8dp"
                        style="@style/TextAppearance.LCK.Medium.12sp"
                        android:gravity="center"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_signup_myteam_dk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/shape_team_background"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="10dp">

                    <View
                        android:id="@+id/iv_signup_myteam_dplus_kia"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/shape_oval_red"
                        android:backgroundTint="@color/white"
                        android:layout_gravity="center"/>

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="DK"
                        android:layout_marginTop="8dp"
                        style="@style/TextAppearance.LCK.Medium.12sp"
                        android:gravity="center"/>

                </LinearLayout>
            </TableRow>

            <TableRow>

                <LinearLayout
                    android:id="@+id/layout_signup_myteam_kt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/shape_team_background"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginVertical="9dp">

                    <View
                        android:id="@+id/iv_signup_myteam_kt_rolster"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/shape_oval_red"
                        android:backgroundTint="@color/t1"
                        android:layout_gravity="center"/>

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="Kt"
                        android:layout_marginTop="8dp"
                        style="@style/TextAppearance.LCK.Medium.12sp"
                        android:gravity="center"/>

                </LinearLayout>
            </TableRow>

        </TableLayout>

        <TextView
            android:id="@+id/tv_signup_myteam_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_rect_4_gray_line_black_fill"
            android:text="다음"
            style="@style/TextAppearance.LCK.Medium.12sp"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="58dp"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
