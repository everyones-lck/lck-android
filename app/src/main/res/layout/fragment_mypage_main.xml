<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.MainActivity"
        android:background="@color/new_bg">

        <LinearLayout
            android:id="@+id/layout_mypage_main_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="31dp"
            android:paddingVertical="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_mypage_main_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_mypage_back"/>

            <TextView
                android:id="@+id/tv_mypage_main_topbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY Page"
                style="@style/TextAppearance.LCK.Medium.16sp"
                android:textColor="@color/white"
                android:layout_weight="1"
                android:gravity="center"/>

            <ImageView
                android:id="@+id/iv_mypage_main_setting"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_mypage_setting"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_mypage_main_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/layout_mypage_main_topbar"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="24dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/iv_mypage_main_rect"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/iv_mypage_main_profile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/img_signup_profile"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/tv_mypage_main_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="닉네임"
                        style="@style/TextAppearance.LCK.Light.20sp"
                        android:textColor="@color/text_white"/>
                    
                    <TextView
                        android:id="@+id/tv_mypage_main_team"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kt"
                        style="@style/TextAppearance.LCK.Medium.10sp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/shape_rect_4_gray_fill"
                        android:padding="4dp"
                        android:layout_gravity="center"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_mypage_main_my_tier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tier"
                    style="@style/TextAppearance.LCK.Light.14sp"
                    android:textColor="@color/grayscale_300"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/grayscale_900"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginHorizontal="30dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/layout_mypage_main_profile"
            android:layout_marginTop="36dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_mypage_main_myprofile_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY Profile"
                style="@style/TextAppearance.LCK.Light.14sp"/>
            
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white_20"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_mypage_main_myteam_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY Team"
                style="@style/TextAppearance.LCK.Light.14sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white_20"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_mypage_main_community_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY Post &amp; Comment"
                style="@style/TextAppearance.LCK.Light.14sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white_20"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_mypage_main_viewing_party_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY Viewing Party"
                style="@style/TextAppearance.LCK.Light.14sp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>