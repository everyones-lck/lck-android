<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_today_match_lck_match"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_today_match_lck_match_team1_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.LCK.Medium"
            android:text="Gen.G"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_marginTop="15dp"
            app:layout_constraintStart_toStartOf="@id/layout_today_match_vote_bar"
            app:layout_constraintTop_toBottomOf="@+id/layout_today_match_vote_bar"/>

        <TextView
            android:id="@+id/tv_today_match_lck_match_team2_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.LCK.Medium"
            android:text="T1"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_marginTop="15dp"
            app:layout_constraintEnd_toEndOf="@id/layout_today_match_vote_bar"
            app:layout_constraintTop_toBottomOf="@+id/layout_today_match_vote_bar"/>

        <TextView
            android:id="@+id/tv_today_match_lck_match1_content"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            style="@style/TextAppearance.LCK.Bold"
            android:text="LCK Summer 1st Match"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/tv_today_match_lck_match1_date"
            app:layout_constraintStart_toStartOf="@id/tv_today_match_lck_match1_date" />

        <TextView
            android:id="@+id/tv_today_match_lck_match1_date"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            style="@style/TextAppearance.LCK.Light"
            android:text="2024.07.12 17:00"
            android:textColor="@color/gray_200"
            android:textSize="9sp"
            android:layout_marginTop="25dp"
            android:layout_marginStart="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/layout_today_match_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="50dp"
            app:layout_constraintTop_toBottomOf="@+id/layout_today_match_vote_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_today_match1_prediction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LCK.Light"
                android:text="승부 예측하기"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:paddingVertical="9dp"
                android:paddingHorizontal="15dp"
                android:background="@drawable/shape_rect_4_white_line"
                app:layout_constraintEnd_toStartOf="@+id/tv_today_match1_pog"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_today_match_vote_bar"/>

            <TextView
                android:id="@+id/tv_today_match1_pog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LCK.Light"
                android:text="Today's POG"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:paddingVertical="9dp"
                android:paddingHorizontal="15dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/shape_rect_4_white_line" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_today_match_vote_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="30dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_today_match_lck_match1_content">

            <TextView
                android:id="@+id/tv_today_match_team1_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="60"
                android:background="@drawable/shape_rect_12_white_fill"
                android:backgroundTint="@color/gen_g"
                android:paddingVertical="2dp"
                android:textSize="2dp"
                android:layout_marginEnd="2dp"/>

            <TextView
                android:id="@+id/tv_today_match_team2_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="40"
                android:background="@drawable/shape_rect_12_white_fill"
                android:backgroundTint="@color/t1"
                android:paddingVertical="2dp"
                android:textSize="2dp"
                android:layout_marginStart="2dp"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_700"
            android:layout_marginTop="25dp"
            android:layout_marginHorizontal="7dp"
            app:layout_constraintTop_toBottomOf="@+id/layout_today_match_button_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>