<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.MainActivity"
        android:background="@color/new_bg">

        <LinearLayout
            android:id="@+id/layout_mypage_main_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="31dp"
            android:paddingVertical="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_mypage_myteam_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_mypage_back"/>

            <TextView
                android:id="@+id/tv_mypage_myteam_topbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MY Team"
                style="@style/TextAppearance.LCK.Medium.16sp"
                android:textColor="@color/white"
                android:layout_weight="1"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tv_mypage_myteam_topbar_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="변경"
                style="@style/TextAppearance.LCK.Light.Body_14sp"
                android:textColor="@color/white"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:background="@drawable/shape_rect_12_white_line"/>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/layout_mypage_myteam_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/layout_mypage_main_topbar"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="24dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/iv_mypage_myteam_rect"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/iv_mypage_myteam_profile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/img_signup_profile"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/tv_mypage_myteam_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="닉네임"
                        style="@style/TextAppearance.LCK.Light.20sp"
                        android:textColor="@color/text_white"/>

                    <TextView
                        android:id="@+id/tv_mypage_myteam_team"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kt"
                        style="@style/TextAppearance.LCK.Medium.10sp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/shape_rect_4_gray_fill"
                        android:padding="4dp"
                        android:layout_gravity="center"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_mypage_myteam_my_tier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tier"
                    style="@style/TextAppearance.LCK.Light.14sp"
                    android:textColor="@color/grayscale_300"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_mypage_myteam_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/layout_mypage_myteam_profile">

            <TextView
                android:id="@+id/tv_mypage_myteam_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My team은 한달에 한 번 변경 가능합니다"
                style="@style/TextAppearance.LCK.Light.12sp"
                android:layout_marginTop="26dp"
                android:textColor="@color/warning"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TableLayout
                android:id="@+id/layout_mypage_myteam_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_mypage_myteam_warning"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TableRow>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_hanwha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_rect_4_grayscale_600_line"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginVertical="9dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_hanhwa"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/hanhwa"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="Hanwha"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_gen_g"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_rect_4_grayscale_600_line"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginHorizontal="8dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_gen_g"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/gen_g"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="Gen.G"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_t1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_rect_4_grayscale_600_line"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_t1"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/t1"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="T1"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>
                </TableRow>

                <TableRow>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_dn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_rect_4_grayscale_600_line"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginVertical="9dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_kwangdong_freecs"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/dn"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="DN"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_bnk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_rect_4_grayscale_600_line"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginHorizontal="8dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_bnk"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/bnk"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="BNK"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_red"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_rect_4_grayscale_600_line"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_nongshim_red_force"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="RED"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>
                </TableRow>

                <TableRow>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_drx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_rect_4_grayscale_600_line"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginVertical="9dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_drx"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/drx"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="DRX"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_brion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_rect_4_grayscale_600_line"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginHorizontal="8dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_ok_saving_bank_brion"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/brion"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="Brion"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_dk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_rect_4_grayscale_600_line"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_dplus_kia"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/white"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="DK"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>
                </TableRow>

                <TableRow>

                    <LinearLayout
                        android:id="@+id/layout_mypage_myteam_kt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/shape_rect_4_grayscale_600_line"
                        android:paddingVertical="20dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginVertical="9dp">

                        <View
                            android:id="@+id/iv_mypage_myteam_kt_rolster"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_oval_red"
                            android:backgroundTint="@color/t1"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="Kt"
                            android:layout_marginTop="8dp"
                            style="@style/TextAppearance.LCK.Medium.12sp"
                            android:gravity="center"/>

                    </LinearLayout>
                </TableRow>

            </TableLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>