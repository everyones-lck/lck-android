<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <ImageView
        android:id="@+id/iv_home_winner_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/shape_oval_none"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_home_result_team1"
        app:layout_constraintBottom_toBottomOf="@+id/tv_home_result_team1"/>

    <TextView
        android:id="@+id/tv_home_result_team1"
        style="@style/Esamanru.Medium.label01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KT Rolster"
        android:textColor="@color/gray_100"
        android:textSize="12sp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@+id/iv_home_winner_dot"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tv_home_result_versus"
        style="@style/Esamanru.Medium.label01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" VS "
        android:textColor="@color/gray_700"
        android:textSize="12sp"
        android:layout_marginStart="120dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_home_result_team1" />

    <TextView
        android:id="@+id/tv_home_result_team2"
        style="@style/Esamanru.Medium.label01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="0dp"
        android:text="Dplus KIA"
        android:textColor="@color/gray_700"
        android:textSize="12sp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@+id/tv_home_result_versus"
        app:layout_constraintTop_toTopOf="@id/tv_home_result_team1"
        app:layout_constraintBottom_toBottomOf="@id/tv_home_result_team1"/>

    <TextView
        android:id="@+id/tv_home_result_date1"
        style="@style/Esamanru.Light.label03"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="2024.05.11 17:00"
        android:textColor="@color/gray_100"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_home_result_team1"
        app:layout_constraintBottom_toBottomOf="@+id/tv_home_result_team1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white"
        android:alpha="0.4"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>