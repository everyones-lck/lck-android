<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.MainActivity"
        android:background="@color/new_bg">

        <LinearLayout
            android:id="@+id/layout_mypage_profile_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="31dp"
            android:paddingVertical="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_mypage_profile_withdraw_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:src="@drawable/ic_back_btn"/>

            <TextView
                android:id="@+id/tv_mypage_profile_withdraw_topbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="계정탈퇴"
                android:textAppearance="@style/Esamanru.Medium.heading01"
                android:textColor="@color/grayscale_200"
                android:layout_weight="1"
                android:gravity="center"/>

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/layout_mypage_profile_topbar"
            android:layout_marginTop="44dp"
            android:layout_marginHorizontal="24dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/img_withdraw"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="탈퇴 전, 잠시만요"
                android:textAppearance="@style/Esamanru.Light.Title02"
                android:textColor="@color/white"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="지금까지 Evr.LOL을 사용해주셔서 감사했습니다 &#10;혹시 불편하셨던 점이 있었다면 들려주세요 &#10;더 나은 Evr.LOL을 만드는데 큰 도움이 됩니다"
                android:textAppearance="@style/Esamanru.Light.body03"
                android:textColor="@color/grayscale_600"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="탈퇴 전, 이건 꼭 확인해주세요"
                android:textAppearance="@style/Esamanru.Light.Title02"
                android:textColor="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="탈퇴하면, 회원정보와 채팅 등 개인 기록 모두 삭제됩니다 &#10;커뮤니티 글 / 댓글은 자동 삭제되지 않아요 &#10;탈퇴 후 본인 확인이 불가능해, 삭제하기 어렵습니다"
                android:textAppearance="@style/Esamanru.Light.body03"
                android:textColor="@color/grayscale_600"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_mypage_profile_withdraw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_rect_4_gray_line_black_fill"
            android:text="확인"
            android:textAppearance="@style/Esamanru.Medium.body02"
            android:textColor="@color/grayscale_200"
            android:gravity="center"
            android:paddingVertical="19dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="58dp"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>