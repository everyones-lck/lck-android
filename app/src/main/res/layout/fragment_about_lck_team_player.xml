<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/new_bg">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:overScrollMode="never">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_about_lck_team_player_pre"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="16.25dp"
                    android:layout_marginTop="26dp"
                    android:src="@drawable/ic_arrow_thin_previous"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_about_lck_team_player_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T1"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/esamanru_light"
                    app:layout_constraintTop_toTopOf="@id/iv_about_lck_team_player_pre"
                    app:layout_constraintBottom_toBottomOf="@id/iv_about_lck_team_player_pre"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/view_about_lck_team_player"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="20dp"
                    android:background="#000000"
                    app:layout_constraintTop_toBottomOf="@id/tv_about_lck_team_player_title"
                    tools:layout_editor_absoluteX="0dp" />

                <TextView
                    android:id="@+id/tv_about_lck_team_player_nick_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAKER"
                    android:textSize="40sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/esamanru_bold"
                    android:layout_marginStart="30dp"
                    app:layout_constraintTop_toTopOf="@id/view_about_lck_team_player"
                    app:layout_constraintBottom_toBottomOf="@id/view_about_lck_team_player"
                    app:layout_constraintStart_toStartOf="parent"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="35dp"
                    android:gravity="right"
                    app:layout_constraintTop_toTopOf="@id/view_about_lck_team_player"
                    app:layout_constraintBottom_toBottomOf="@id/view_about_lck_team_player"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/tv_about_lck_team_player_birth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1996.05.07"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:fontFamily="@font/cafe_ohsquare_air"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <ImageView
                            android:id="@+id/iv_about_lck_team_player_position"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:src="@drawable/ic_mid"
                            android:layout_gravity="center"/>

                        <TextView
                            android:id="@+id/tv_about_lck_team_player_position"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MID"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:fontFamily="@font/cafe_ohsquare_air"
                            android:layout_marginStart="4dp"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_about_lck_team_player_real_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이상혁"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/cafe_ohsquare_air"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_about_lck_team_player_winning_career"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Winning Career"
                    android:fontFamily="@font/esamanru_light"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="40dp"
                    app:layout_constraintTop_toBottomOf="@id/view_about_lck_team_player"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="30dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_about_lck_team_player_winning_career"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="9dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_about_lck_team_player_winning_career"
                    android:overScrollMode="never"/>

                <View
                    android:id="@+id/view_about_lck_team_player_winning_career_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#656565"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rv_about_lck_team_player_winning_career"/>

                <ImageView
                    android:id="@+id/iv_about_lck_team_player_winning_career_down"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_aboutlck_arrow_down"
                    android:layout_marginEnd="30dp"
                    app:layout_constraintTop_toTopOf="@id/tv_about_lck_team_player_winning_career"
                    app:layout_constraintBottom_toBottomOf="@id/tv_about_lck_team_player_winning_career"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tv_about_lck_team_player_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History"
                    android:fontFamily="@font/esamanru_light"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="27dp"
                    app:layout_constraintTop_toBottomOf="@id/view_about_lck_team_player_winning_career_line"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="30dp"/>

                <ImageView
                    android:id="@+id/iv_about_lck_team_player_history_down"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_aboutlck_arrow_down"
                    android:layout_marginEnd="30dp"
                    app:layout_constraintTop_toTopOf="@id/tv_about_lck_team_player_history"
                    app:layout_constraintBottom_toBottomOf="@id/tv_about_lck_team_player_history"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_about_lck_team_player_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="9dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_about_lck_team_player_history"
                    android:overScrollMode="never"/>

                <View
                    android:id="@+id/view_about_lck_team_player_transparent"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="50dp"
                    android:background="#00FFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/rv_about_lck_team_player_history" />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>