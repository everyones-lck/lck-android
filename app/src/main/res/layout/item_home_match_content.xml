<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <ImageView
        android:id="@+id/iv_home_today_match_box"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginHorizontal="19dp"
        android:background="@drawable/shape_rect_8_gray_300_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_home_match_container"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginHorizontal="19dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_home_match_logo"
            android:layout_width="23dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_logo"
            android:layout_marginStart="25dp"
            android:layout_marginTop="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tv_home_match_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.LCK.Medium"
            android:text="2025 LCK CUP 1st Match"
            android:textSize="18sp"
            android:textColor="@color/gray_100"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="@+id/iv_home_match_logo"
            app:layout_constraintTop_toBottomOf="@+id/iv_home_match_logo"/>

        <TextView
            android:id="@+id/tv_home_match_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Esamanru.Light.body03"
            android:text="2025. 01. 01 12:00"
            android:textColor="@color/gray_500"
            android:textSize="14sp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_home_match_title"
            app:layout_constraintStart_toStartOf="@id/iv_home_match_logo"/>

        <LinearLayout
            android:id="@+id/layout_home_match_prediction_bar"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@drawable/shape_rect_12_white_fill"
            android:orientation="horizontal"
            android:clipToOutline="true"
            android:gravity="center_vertical"
            android:layout_marginTop="33dp"
            android:layout_marginHorizontal="25dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_home_match_date">

            <View
                android:id="@+id/view_home_match_team1_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/gray_600" />

            <View
                android:id="@+id/view_home_match_team2_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/gray_100" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_home_match_team1_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Esamanru.Medium.body02"
            android:text="-"
            android:textSize="14sp"
            android:textColor="@color/gray_100"
            android:layout_marginTop="15dp"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toStartOf="@id/layout_home_match_prediction_bar"
            app:layout_constraintTop_toBottomOf="@+id/layout_home_match_prediction_bar"/>

        <TextView
            android:id="@+id/tv_home_match_team2_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Esamanru.Medium.body02"
            android:text="-"
            android:textSize="14sp"
            android:textColor="@color/gray_100"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintEnd_toEndOf="@id/layout_home_match_prediction_bar"
            app:layout_constraintTop_toBottomOf="@+id/layout_home_match_prediction_bar"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_home_no_match"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginHorizontal="19dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageView
            android:id="@+id/iv_home_no_match_logo"
            android:layout_width="23dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_logo"
            android:layout_marginStart="25dp"
            android:layout_marginTop="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tv_home_no_match_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.LCK.Medium"
            android:text="No Match"
            android:textSize="18sp"
            android:textColor="@color/gray_100"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="@+id/iv_home_no_match_logo"
            app:layout_constraintTop_toBottomOf="@+id/iv_home_no_match_logo"/>

        <TextView
            android:id="@+id/tv_home_no_match_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Esamanru.Light.body03"
            android:text="0000. 00. 00 00:00"
            android:textColor="@color/gray_500"
            android:textSize="14sp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_home_no_match_title"
            app:layout_constraintStart_toStartOf="@id/iv_home_no_match_logo"/>

        <LinearLayout
            android:id="@+id/layout_home_no_match_prediction_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:layout_marginHorizontal="25dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_home_no_match_date">

            <TextView
                android:id="@+id/tv_home_no_match_team1_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape_rect_12_white_fill"
                android:backgroundTint="@color/gray_900"
                android:paddingVertical="5dp"
                android:textSize="2dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_home_no_match_team1_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Esamanru.Medium.body02"
            android:text="-"
            android:textSize="14sp"
            android:textColor="@color/gray_100"
            android:layout_marginTop="15dp"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toStartOf="@id/layout_home_no_match_prediction_bar"
            app:layout_constraintTop_toBottomOf="@+id/layout_home_no_match_prediction_bar"/>

        <TextView
            android:id="@+id/tv_home_no_match_team2_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Esamanru.Medium.body02"
            android:text="-"
            android:textSize="14sp"
            android:textColor="@color/gray_100"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintEnd_toEndOf="@id/layout_home_no_match_prediction_bar"
            app:layout_constraintTop_toBottomOf="@+id/layout_home_no_match_prediction_bar"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>